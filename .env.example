# =============================================================================
# Nexora environment configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# =============================================================================

# --- Django ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-value
DEBUG=true

# NOTE: do not set DJANGO_SETTINGS_MODULE here. Docker images default to
# production settings (compose honors an explicit override if ever needed),
# while `manage.py` defaults to development for bare-metal work.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
CSRF_TRUSTED_ORIGINS=

# --- JWT ---------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Auth rate limiting (H-2) -------------------------------------------------
# Scoped anonymous throttles for authentication endpoints. Counters are stored
# in the cache backend (Redis when REDIS_URL is set; production requires it).
AUTH_THROTTLE_LOGIN=10/min
AUTH_THROTTLE_REGISTER=5/min
AUTH_THROTTLE_REFRESH=30/min
# Number of trusted reverse proxies appending to X-Forwarded-For (used to pick
# the real client address for throttle keys). "0" trusts REMOTE_ADDR only.
NUM_PROXIES=1

# --- Uploads -------------------------------------------------------------------
# Maximum accepted avatar size in megabytes (validated server-side; content is
# sniffed with Pillow — client MIME types and filenames are not trusted).
AVATAR_MAX_SIZE_MB=2

# --- PostgreSQL --------------------------------------------------------------
# Inside Docker Compose the host is `postgres`; for local (non-Docker) runs
# use `localhost`.
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ----------------------------------------------------------
# Leave empty to use in-memory defaults for local (non-Docker) development.
#
# L-8: Redis inside Docker Compose requires authentication. REDIS_PASSWORD is
# used to build authenticated cache/broker URLs in docker-compose.yml. An
# empty value falls back to a well-known development password so
# `docker compose up` works locally; set a strong random value for any real
# deployment. Avoid characters needing URL-encoding (: / @ ?).
REDIS_PASSWORD=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_TASK_ALWAYS_EAGER=false

# --- HTTP surface hardening --------------------------------------------------
# API schema/docs (Swagger UI, ReDoc, OpenAPI schema at /api/docs/,
# /api/redoc/, /api/schema/). Development settings enable them by default;
# production settings DISABLE them by default. Uncomment to expose docs in a
# production-like deployment (prefer restricting at your TLS edge instead).
# NOTE: an empty value counts as "false" - comment the line out entirely to
# get the environment's default.
# API_DOCS_ENABLED=true

# Django admin (/admin/): enabled by default in every environment. Set to
# false to remove the admin surface completely (users are then administered
# via `manage.py` / API only).
# ADMIN_ENABLED=false

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO

# --- Frontend (build-time) ---------------------------------------------------
VITE_API_BASE_URL=/api/v1
